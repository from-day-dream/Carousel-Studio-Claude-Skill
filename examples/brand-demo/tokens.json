{
  "canvas": {
    "width": 1080,
    "height": 1350
  },
  "colors": {
    "paper": {
      "value": "#f3eee4",
      "role": "background"
    },
    "ink": {
      "value": "#1d1b18",
      "role": "text; background for inverse slides"
    },
    "muted": {
      "value": "#5f594f",
      "role": "secondary text"
    },
    "accent": {
      "value": "#a63d16",
      "role": "accent on paper"
    },
    "accentOnInk": {
      "value": "#ec9a74",
      "role": "accent on ink"
    },
    "grid": {
      "value": "#e2dacb",
      "role": "grid-paper lines (never text)"
    }
  },
  "fonts": {
    "heading": {
      "family": "Fraunces",
      "source": "google",
      "files": [
        {
          "path": "fonts/Fraunces-600-italic.ttf",
          "weight": 600,
          "style": "italic"
        },
        {
          "path": "fonts/Fraunces-600.ttf",
          "weight": 600,
          "style": "normal"
        }
      ]
    },
    "body": {
      "family": "Inter",
      "source": "google",
      "files": [
        {
          "path": "fonts/Inter-400.ttf",
          "weight": 400,
          "style": "normal"
        },
        {
          "path": "fonts/Inter-600.ttf",
          "weight": 600,
          "style": "normal"
        }
      ]
    }
  },
  "typeScale": {
    "hook": 132,
    "headline": 96,
    "key": 44,
    "support": 32,
    "item": 38,
    "clarifier": 28,
    "meta": 22
  },
  "spacing": {
    "margin": 96,
    "safeArea": 72,
    "gridColumns": 6,
    "gutter": 24,
    "gridCell": 54
  },
  "minFontSize": {
    "default": 28,
    "meta": 20
  },
  "logo": {
    "primary": "logo/mark-ink.svg",
    "alt": "logo/mark-paper.svg",
    "minWidth": 96
  },
  "retention": {}
}
